#!/bin/sh
# Avvia la dashboard PAYSLIP//CORE usando la cartella del progetto per i PDF.
set -eu

APP_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

export BUSTE_DIR="${BUSTE_DIR:-$APP_DIR}"
cd "$APP_DIR"

if [ -x "$APP_DIR/.venv/bin/python" ]; then
    PYTHON="$APP_DIR/.venv/bin/python"
else
    PYTHON=python3
fi

exec "$PYTHON" server.py
